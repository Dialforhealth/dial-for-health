rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function isAdmin(){ return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true; }
    match /doctors/{id} { allow read: if true; allow write: if isAdmin(); }
    match /admins/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /appointments/{id} { allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin()); allow create, update, delete: if false; }
    match /appointment_slots/{id} { allow read, write: if false; }
    match /notifications/{id} { allow read: if signedIn() && resource.data.targetUserId == request.auth.uid; allow update: if signedIn() && resource.data.targetUserId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']); allow create, delete: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}